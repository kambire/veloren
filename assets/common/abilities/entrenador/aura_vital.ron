// Curación en área para el Entrenador, su mascota y su grupo.
// Restaura un 20% de salud máxima de forma instantánea ("de una") y luego continúa
// con una curación residual suave de 2 HP/s durante 10 segundos (~20 puntos adicionales).
BasicAura(
    buildup_duration: 0.15,
    cast_duration: 0.35,
    recover_duration: 0.15,
    targets: InGroup,
    auras: [
        (
            kind: Regeneration,
            strength: 2.0,
            duration: Some(10),
        ),
    ],
    aura_duration: Some(1.5),
    range: 30.0,
    energy_cost: 20.0,
    scales_with_combo: false,
    specifier: Some(HealingAura),
)
