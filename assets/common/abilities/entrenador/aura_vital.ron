// Curación en área de alta potencia para el Entrenador, su mascota y su grupo.
// Restaura un 20% de salud máxima de forma instantánea ("de una") y luego continúa
// curando mediante regeneración sostenida durante 8 segundos (~360 puntos adicionales, ~45 HP/s).
BasicAura(
    buildup_duration: 0.15,
    cast_duration: 0.35,
    recover_duration: 0.15,
    targets: InGroup,
    auras: [
        (
            kind: Regeneration,
            strength: 45.0,
            duration: Some(8),
        ),
    ],
    aura_duration: Some(1.5),
    range: 30.0,
    energy_cost: 20.0,
    scales_with_combo: false,
    specifier: Some(HealingAura),
)
